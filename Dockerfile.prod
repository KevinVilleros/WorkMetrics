# Dockerfile para producción con compilación multi-etapa
FROM python:3.11-slim as backend-builder

WORKDIR /app/backend

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copiar y instalar dependencias Python
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Etapa de frontend
FROM node:18-alpine as frontend-builder

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend . .
RUN npm run build

# Etapa final
FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias de runtime
RUN apt-get update && apt-get install -y \
    libpq5 \
    postgresql-client \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copiar backend
COPY --from=backend-builder /app/backend /app/backend
COPY backend/requirements.txt /app/backend/

# Copiar frontend
COPY --from=frontend-builder /app/frontend/build /app/frontend/build

# Instalar Python dependencies en imagen final
RUN cd /app/backend && pip install --no-cache-dir -r requirements.txt

# Crear usuario no-root
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

WORKDIR /app/backend

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health/').raise_for_status()"

# Variables de entorno
ENV PYTHONUNBUFFERED=1
ENV DEBUG=False

# Exponer puertos
EXPOSE 8000

# Ejecutar Gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "4", "--worker-class", "sync", "config.wsgi:application"]
