{
  "name": "metriclab-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "electron.js",
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_detection": "^0.4.1657300184",
    "axios": "^1.16.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "electron": "^42.3.3",
    "electron-packager": "^17.1.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron:build": "npm run build && electron .",
    "electron:package": "npm run build && electron-packager . MetricLab --platform=win32 --arch=x64 --out=dist --overwrite --ignore=node_modules"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
